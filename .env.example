# SQLite paths resolve from the project root, consistently for CLI and runtime.
DATABASE_URL="file:./prisma/dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Assets are public reads. Switch to s3/r2 in stage 2 without changing object keys.
ASSET_STORAGE_DRIVER="local"
ASSET_PUBLIC_BASE_URL="/assets"
ASSET_MANIFEST_PATH="/assets/assets.json"

# Server-only. Generate a random secret before implementing anonymous sessions.
# Never expose a signing secret or storage credentials via NEXT_PUBLIC_*.
SESSION_SECRET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
